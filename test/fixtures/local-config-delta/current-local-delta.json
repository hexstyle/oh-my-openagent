{
  "audit_scope": "minimum-supported-delta",
  "evidence": {
    "managed_host_asset": "assets/custom-opencode/opencode.json",
    "managed_plugin_asset": "assets/custom-opencode/oh-my-opencode.json",
    "installer": "script/install-local-opencode-fork.sh",
    "asset_sync": "script/sync-custom-opencode-assets.ts",
    "verifier": "script/verify-local-opencode-install.ts",
    "runtime_hooks": [
      "src/plugin/hooks/create-session-hooks.ts",
      "src/hooks/runtime-fallback/hook.ts",
      "src/shared/codex-auth-bootstrap.ts",
      "src/shared/agent-display-names.ts",
      "src/plugin-handlers/agent-key-remapper.ts"
    ]
  },
  "categories": {
    "config_only_deltas": [
      {
        "id": "managed-local-config-assets",
        "summary": "The fork commits the OpenCode host/plugin config and installs them locally via the repo.",
        "evidence": {
          "files": [
            "assets/custom-opencode/opencode.json",
            "assets/custom-opencode/oh-my-opencode.json"
          ],
          "live_alias": "oh-my-openagent.json",
          "default_agent": "Prometheus (Plan Builder)",
          "instructions": [
            "./node_modules/oh-my-openagent/assets/custom-opencode/instructions/non-interactive-shell.md"
          ],
          "plugin_entries": [
            "oh-my-openagent",
            "opencode-claude-auth",
            "opencode-helicone-session",
            "@nick-vi/opencode-type-inject"
          ]
        }
      },
      {
        "id": "role-specific-model-policy",
        "summary": "Agent and category model policy is part of the managed plugin config.",
        "evidence": {
          "opus_first_agents": [
            "sisyphus",
            "prometheus",
            "oracle",
            "metis",
            "momus"
          ],
          "gpt54_agents": [
            "hephaestus",
            "atlas",
            "librarian",
            "multimodal-looker",
            "sisyphus-junior"
          ],
          "spark_agents": [
            "explore"
          ],
          "primary_categories": {
            "ultrabrain": "anthropic/claude-opus-4-6",
            "deep": "openai/gpt-5.4",
            "quick": "openai/gpt-5.4"
          },
          "context_limit": 200000
        }
      },
      {
        "id": "single-runtime-fallback-policy",
        "summary": "The fork keeps one managed runtime-fallback policy instead of a separate synced plugin layer.",
        "evidence": {
          "config_path": "runtime_fallback",
          "enabled": true,
          "max_fallback_attempts": 12,
          "max_full_chain_cycles": 5,
          "cooldown_seconds": 300,
          "timeout_seconds": 45,
          "transient_retry_window_seconds": 14400,
          "transient_retry_initial_delay_seconds": 30,
          "transient_retry_max_delay_seconds": 300,
          "notify_on_fallback": true
        }
      }
    ],
    "plugin_code_deltas": [
      {
        "id": "local-install-and-live-verification",
        "summary": "Clean install is owned by repo scripts and pins the live host plugin entry to the local checkout.",
        "evidence": {
          "files": [
            "script/install-local-opencode-fork.sh",
            "script/sync-custom-opencode-assets.ts",
            "script/verify-local-opencode-install.ts"
          ],
          "synced_targets": [
            "opencode.json",
            "oh-my-openagent.json"
          ],
          "plugin_pin": "file://<repo-root>"
        }
      },
      {
        "id": "codex-auth-bridge",
        "summary": "The fork imports Codex OpenAI OAuth into the OpenCode auth store.",
        "evidence": {
          "file": "src/shared/codex-auth-bootstrap.ts",
          "source": "~/.codex/auth.json",
          "target": "~/.local/share/opencode/auth.json"
        }
      },
      {
        "id": "canonical-agent-display-names",
        "summary": "The runtime exposes only canonical `Agent (Role)` display names, with `explore` kept as the internal key.",
        "evidence": {
          "files": [
            "src/shared/agent-display-names.ts",
            "src/plugin-handlers/agent-key-remapper.ts"
          ],
          "name_format": "Agent (Role)",
          "special_case_runtime_key": "explore",
          "special_case_display_name": "Explore (Code Search)"
        }
      },
      {
        "id": "in-process-runtime-fallback",
        "summary": "Runtime resilience lives inside the main TypeScript plugin hook chain rather than synced external JS plugins.",
        "evidence": {
          "hook_factory": "src/plugin/hooks/create-session-hooks.ts",
          "hook_impl": "src/hooks/runtime-fallback/hook.ts",
          "no_external_managed_plugin_assets": true
        }
      }
    ],
    "intended_extension_points": [
      {
        "id": "schema-supported-agent-and-runtime-overrides",
        "summary": "Installed schema supports agent/category overrides, prompt_append, and the audited runtime knobs.",
        "evidence": {
          "file": "assets/oh-my-opencode.schema.json",
          "supported_paths": [
            "agents.*.model",
            "agents.*.variant",
            "agents.*.textVerbosity",
            "agents.*.prompt_append",
            "categories.*.model",
            "categories.*.variant",
            "categories.*.textVerbosity",
            "runtime_fallback.enabled",
            "runtime_fallback.max_fallback_attempts",
            "background_task.staleTimeoutMs",
            "experimental.preemptive_compaction"
          ]
        }
      },
      {
        "id": "config-merge-semantics",
        "summary": "Managed user config loads first, local model override loads second, project config overrides last; agents/categories deep-merge and disabled arrays union.",
        "evidence": {
          "file": "src/plugin-config.ts",
          "merge_rules": [
            "managed user config first",
            "local user override second",
            "project config overrides last",
            "agents deepMerge",
            "categories deepMerge",
            "disabled_* arrays union"
          ]
        }
      },
      {
        "id": "explicit-plugin-array-registration",
        "summary": "OpenCode host config expects explicit plugin array registration and normalizes canonical versus legacy entries.",
        "evidence": {
          "file": "src/cli/config-manager/add-plugin-to-opencode-config.ts",
          "preferred_entry": "oh-my-openagent",
          "legacy_entry": "oh-my-opencode"
        }
      },
      {
        "id": "legacy-alias-basename-compatibility",
        "summary": "Legacy oh-my-opencode alias/basename handling remains compatibility behavior and should not be treated as drift.",
        "evidence": {
          "file": "src/shared/jsonc-parser.ts",
          "preference_order": [
            "oh-my-openagent",
            "oh-my-opencode"
          ]
        }
      }
    ],
    "suspicious_runtime_drift": []
  }
}
