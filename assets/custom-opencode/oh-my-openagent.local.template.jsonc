{
  // Optional local overrides merged on top of the managed
  // ~/.config/opencode/oh-my-openagent.json base.
  //
  // Use this file for user-specific model policy changes.
  // The installer preserves it across reruns.
  //
  // Supported examples:
  //
  // "agents": {
  //   "sisyphus-junior": {
  //     "model": "anthropic/claude-sonnet-4-6",
  //     "variant": "medium",
  //     "reasoningEffort": "medium",
  //     "fallback_models": [
  //       "anthropic/claude-sonnet-4-6",
  //       "anthropic/claude-opus-4-7",
  //       "openai/gpt-5.4",
  //       "openai/gpt-5.3-codex-spark",
  //       // Keep all paid OpenAI/Codex + Claude models ahead of free fallbacks.
  //       "opencode/nemotron-3-super-free",
  //       "opencode/minimax-m2.5-free",
  //       "opencode/big-pickle"
  //     ]
  //   }
  // },
  //
  // "categories": {
  //   "quick": {
  //     "model": "anthropic/claude-sonnet-4-6"
  //   }
  // },
  //
  // "runtime_fallback": {
  //   // Optional: keep tracked Claude/Codex 403 provider blocks on the same paid model
  //   // for a short manual-clearance window instead of immediately advancing the chain.
  //   "manual_provider_clearance_enabled": true,
  //   "manual_provider_clearance_pause_window_seconds": 600,
  //   "manual_provider_clearance_notify_on_pause": true
  // }
}
