{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "prometheus",
  "plugin": [
    "oh-my-openagent",
    "@ex-machina/opencode-anthropic-auth"
  ],
  "lsp": {
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "csharp": {
      "command": [
        "csharp-ls"
      ],
      "extensions": [
        ".cs"
      ]
    }
  }
}
